# Admin dashboard password. Default used in local preview: meridian-admin
ADMIN_PASSWORD=meridian-admin

# Optional HMAC secret for the admin session cookie. Falls back to ADMIN_PASSWORD.
ADMIN_SECRET=change-me-in-production

# Optional override for where applicants.csv and cvs/ live.
# Defaults to ./data in this project.
DATA_DIR=./data

# Public origin used in notification links.
PUBLIC_APP_URL=

# Matching weights (must sum conceptually to 100).
MATCH_WEIGHT_SKILLS=30
MATCH_WEIGHT_EXPERIENCE=20
MATCH_WEIGHT_TITLE=15
MATCH_WEIGHT_SENIORITY=10
MATCH_WEIGHT_LOCATION=10
MATCH_WEIGHT_EMPLOYMENT=5
MATCH_WEIGHT_SALARY=5
MATCH_WEIGHT_OTHER=5

# Notification thresholds
MATCH_NOTIFICATION_THRESHOLD=75
TELEGRAM_NOTIFICATION_THRESHOLD=75
EMAIL_NOTIFICATION_THRESHOLD=80
MATCH_INSTANT_THRESHOLD=90
MATCHING_INTERVAL_MINUTES=30

# Telegram bot. Leave empty to skip Telegram delivery.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Email. Leave empty to skip email delivery.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=

# Optional xAI key for explanation enhancement (never required for scoring).
# XAI_API_KEY=
